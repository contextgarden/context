%D \module
%D   [       file=type-imp-libron,
%D        version=2026.10.05,
%D          title=\CONTEXT\ Typescript Macros,
%D       subtitle=Libron fonts,
%D         author=Hans Hagen,
%D           date=\currentdate,
%D      copyright={PRAGMA ADE \& \CONTEXT\ Development Team}]
%C
%C This module is part of the \CONTEXT\ macro||package and is
%C therefore copyrighted by \PRAGMA. See mreadme.pdf for
%C details.

% \setupbodyfont[libron,10pt]
%
% \setupalign[mathbookpasses]
%
% \starttext
%     {\tf \samplefile{tufte}}\blank
%     {\bf \samplefile{tufte}}\blank
%     {\it \samplefile{tufte}}\blank
%     {\bi \samplefile{tufte}}\blank
% \stoptext

\usetypescriptfile[dejavu]

\starttypescriptcollection[libron]

\starttypescript [serif] [libron] [name]
    \setups[font:fallback:serif]
    \definefontsynonym[Serif]           [file:libron-regular.ttf]    [features=default]
    \definefontsynonym[SerifItalic]     [file:libron-italic.ttf]     [features=default]
    \definefontsynonym[SerifBold]       [file:libron-bold.ttf]       [features=default]
    \definefontsynonym[SerifBoldItalic] [file:libron-bolditalic.ttf] [features=default]
\stoptypescript

\starttypescript [libron]
    \definetypeface [\typescriptone] [rm] [serif] [libron] [default]
    \definetypeface [\typescriptone] [ss] [sans]  [libron] [default]
    \definetypeface [\typescriptone] [tt] [mono]  [dejavu] [default]
    \definetypeface [\typescriptone] [mm] [math]  [dejavu] [default]
\stoptypescript

\stoptypescriptcollection
