--     DelimiterShortfall                       = "todo",
--     DelimiterExtendMargin                    = "todo",

local function readmathvalue(f,base,getdelta,getdevice)
    local s = readshort(f)
    local d = readushort(f)
    local v = s
    if d ~= 0 and (getdelta or getdevice) then
        -- The offset is relative to the enclosing MATH subtable.
        v = v + readdevicevalue(f,base+d,getdelta,getdevice)
    end
    local factor = s ~= 0 and (v / s) or 0
    return v, factor
end

local function readmathconstants(f,fontdata,offset,getdelta,getdevice)
    local mathconstants    = { }
    local mathfactors      = { }
    fontdata.mathconstants = mathconstants
    fontdata.mathfactors   = mathfactors
    --
    setposition(f,offset)
    local function readconstant(tag)
        mathconstants[tag], mathfactors[tag] = readmathvalue(f,offset,getdelta,getdevice)
    end
    --
    mathconstants.ScriptPercentScaleDown       = readshort(f)
    mathconstants.ScriptScriptPercentScaleDown = readshort(f)
    mathconstants.DelimitedSubFormulaMinHeight = readushort(f)
    mathconstants.DisplayOperatorMinHeight     = readushort(f)
    --
    readconstant("MathLeading")
    readconstant("AxisHeight")
    readconstant("AccentBaseHeight")
    readconstant("FlattenedAccentBaseHeight")
    readconstant("SubscriptShiftDown")
    readconstant("SubscriptTopMax")
    readconstant("SubscriptBaselineDropMin")
    readconstant("SuperscriptShiftUp")
    readconstant("SuperscriptShiftUpCramped")
    readconstant("SuperscriptBottomMin")
    readconstant("SuperscriptBaselineDropMax")
    readconstant("SubSuperscriptGapMin")
    readconstant("SuperscriptBottomMaxWithSubscript")
    readconstant("SpaceAfterScript")
    readconstant("UpperLimitGapMin")
    readconstant("UpperLimitBaselineRiseMin")
    readconstant("LowerLimitGapMin")
    readconstant("LowerLimitBaselineDropMin")
    readconstant("StackTopShiftUp")
    readconstant("StackTopDisplayStyleShiftUp")
    readconstant("StackBottomShiftDown")
    readconstant("StackBottomDisplayStyleShiftDown")
    readconstant("StackGapMin")
    readconstant("StackDisplayStyleGapMin")
    readconstant("StretchStackTopShiftUp")
    readconstant("StretchStackBottomShiftDown")
    readconstant("StretchStackGapAboveMin")
    readconstant("StretchStackGapBelowMin")
    readconstant("FractionNumeratorShiftUp")
    readconstant("FractionNumeratorDisplayStyleShiftUp")
    readconstant("FractionDenominatorShiftDown")
    readconstant("FractionDenominatorDisplayStyleShiftDown")
    readconstant("FractionNumeratorGapMin")
    readconstant("FractionNumeratorDisplayStyleGapMin")
    readconstant("FractionRuleThickness")
    readconstant("FractionDenominatorGapMin")
    readconstant("FractionDenominatorDisplayStyleGapMin")
    readconstant("SkewedFractionHorizontalGap")
    readconstant("SkewedFractionVerticalGap")
    readconstant("OverbarVerticalGap")
    readconstant("OverbarRuleThickness")
    readconstant("OverbarExtraAscender")
    readconstant("UnderbarVerticalGap")
    readconstant("UnderbarRuleThickness")
    readconstant("UnderbarExtraDescender")
    readconstant("RadicalVerticalGap")
    readconstant("RadicalDisplayStyleVerticalGap")
    readconstant("RadicalRuleThickness")
    readconstant("RadicalExtraAscender")
    readconstant("RadicalKernBeforeDegree")
    readconstant("RadicalKernAfterDegree")
    --
    mathconstants.RadicalDegreeBottomRaisePercent = readshort(f)
end

local function readmathglyphinfo(f,fontdata,offset,getdelta,getdevice)
    setposition(f,offset)
    local italics    = readushort(f)
    local accents    = readushort(f)
    local extensions = readushort(f)
    local kerns      = readushort(f)
    local glyphs     = fontdata.glyphs
    if italics ~= 0 then
        setposition(f,offset+italics)
        local coverage  = readushort(f)
        local nofglyphs = readushort(f)
        coverage = readcoverage(f,offset+italics+coverage,true)
        setposition(f,offset+italics+4)
        for i=1,nofglyphs do
            local italic = readmathvalue(f,offset+italics,getdelta,getdevice)
            if italic ~= 0 then
                local glyph = glyphs[coverage[i]]
                local math  = glyph.math
                if not math then
                    glyph.math = { italic = italic }
                else
                    math.italic = italic
                end
            end
        end
        fontdata.hasitalics = true
    end
    if accents ~= 0 then
        setposition(f,offset+accents)
        local coverage  = readushort(f)
        local nofglyphs = readushort(f)
        coverage = readcoverage(f,offset+accents+coverage,true)
        setposition(f,offset+accents+4)
        for i=1,nofglyphs do
            local accent = readmathvalue(f,offset+accents,getdelta,getdevice)
            if accent ~= 0 then
                local glyph = glyphs[coverage[i]]
                local math  = glyph.math
                if not math then
                    glyph.math = { accent = accent }
                else
                    math.accent = accent -- will become math.topanchor
                end
            end
        end
    end
    if extensions ~= 0 then
        local extensionoffset = offset + extensions
        setposition(f,extensionoffset)
        local coverage = readcoverage(f,extensionoffset,true)
        local nofglyphs = #coverage
        for i=1,nofglyphs do
            local glyph = glyphs[coverage[i]]
            if glyph then
                local math = glyph.math
                if math then
                    math.extended = true
                else
                    glyph.math = { extended = true }
                end
            end
        end
    end
    if kerns ~= 0 then
        local kernoffset = offset + kerns
        setposition(f,kernoffset)
        local coverage  = readushort(f)
        local nofglyphs = readushort(f)
        if nofglyphs > 0 then
            local function get(offset)
                setposition(f,kernoffset+offset)
                local n = readushort(f)
                if n == 0 then
                    local k = readmathvalue(f,kernoffset+offset,getdelta,getdevice)
                    if k == 0 then
                        -- no need for it (happens sometimes)
                    else
                        return { { kern = k } }
                    end
                else
                    local l = { }
                    for i=1,n do
                        l[i] = { height = readmathvalue(f,kernoffset+offset,getdelta,getdevice) }
                    end
                    for i=1,n do
                        l[i].kern = readmathvalue(f,kernoffset+offset,getdelta,getdevice)
                    end
                    l[n+1] = { kern = readmathvalue(f,kernoffset+offset,getdelta,getdevice) }
                    return l
                end
            end
            local kernsets = { }
            for i=1,nofglyphs do
                local topright    = readushort(f)
                local topleft     = readushort(f)
                local bottomright = readushort(f)
                local bottomleft  = readushort(f)
                kernsets[i] = {
                    topright    = topright    ~= 0 and topright    or nil,
                    topleft     = topleft     ~= 0 and topleft     or nil,
                    bottomright = bottomright ~= 0 and bottomright or nil,
                    bottomleft  = bottomleft  ~= 0 and bottomleft  or nil,
                }
            end
            coverage = readcoverage(f,kernoffset+coverage,true)
            for i=1,nofglyphs do
                local kernset = kernsets[i]
                if next(kernset) then
                    local k = kernset.topright    if k then kernset.topright    = get(k) end
                    local k = kernset.topleft     if k then kernset.topleft     = get(k) end
                    local k = kernset.bottomright if k then kernset.bottomright = get(k) end
                    local k = kernset.bottomleft  if k then kernset.bottomleft  = get(k) end
                    if next(kernset) then
                        local glyph = glyphs[coverage[i]]
                        local math  = glyph.math
                        if math then
                            math.kerns = kernset
                        else
                            glyph.math = { kerns = kernset }
                        end
                    end
                end
            end
        end
    end
end

local function readmathvariants(f,fontdata,offset,getdelta,getdevice)
    setposition(f,offset)
    local glyphs        = fontdata.glyphs
    local minoverlap    = readushort(f)
    local vcoverage     = readushort(f)
    local hcoverage     = readushort(f)
    local vnofglyphs    = readushort(f)
    local hnofglyphs    = readushort(f)
    local vconstruction = readcardinaltable(f,vnofglyphs,ushort)
    local hconstruction = readcardinaltable(f,hnofglyphs,ushort)

    fontdata.mathconstants.MinConnectorOverlap = minoverlap

    local function get(offset,coverage,nofglyphs,construction,kvariants,kparts,kitalic,korientation,orientation)
        if coverage ~= 0 and nofglyphs > 0 then
            local coverage = readcoverage(f,offset+coverage,true)
            local n = 0
            for i=1,nofglyphs do
                local c = construction[i]
                if c ~= 0 then
                    local index = coverage[i]
                    local glyph = glyphs[index]
                    local math  = glyph.math
                    setposition(f,offset+c)
                    local assembly    = readushort(f)
                    local nofvariants = readushort(f)
                    if nofvariants > 0 then
                        local variants, v = nil, 0
                        for i=1,nofvariants do
                            local variant = readushort(f)
                            if variant == index then
                             -- report("discarding %s variant %04X for %04X, %C","self referencing",variant,index,tonumber(glyph.unicode) or 0xFFFD)
                                n = n + 1
                            elseif variants then
                                v = v + 1
                                variants[v] = variant
                            else
                                v = 1
                                variants = { variant }
                            end
                            skipshort(f)
                        end
                        if not variants or not next(variants) then
                            -- only self
                        elseif not math then
                            math = { [kvariants] = variants }
                            glyph.math = math
                        else
                            math[kvariants] = variants
                        end
                    end
                    if assembly ~= 0 then
                        setposition(f,offset + c + assembly)
                        local italic   = readmathvalue(f,offset+c+assembly,getdelta,getdevice)
                        local nofparts = readushort(f)
                        local parts    = { }
                        for i=1,nofparts do
                            -- These are plain design-unit values in the current MATH format; there
                            -- is no variation index in a GlyphPart record to resolve here.
                            local p = {
                                glyph   = readushort(f),
                                start   = readushort(f),
                                ["end"] = readushort(f),
                                advance = readushort(f),
                            }
-- local g = glyphs[p.glyph]
-- if g then
--     local f = g.axisfactor or 1
--     if f ~= 1 then
--         inspect(g)
--         print("B !!!",p.advance)
--         p.advance = f * p.advance
--         print("A !!!",p.advance)
--     end
-- end
                            local flags = readushort(f)
                            if (flags & 0x0001) ~= 0 then
                                p.extender = 1 -- true
                            end
                            parts[i] = p
                        end
                        if not math then
                            math = {
                                [kparts] = parts
                            }
                            glyph.math = math
                        else
                            math[kparts] = parts
                        end
                        if italic and italic ~= 0 then
                            math[kitalic] = italic
                        end
                        if korientation and orientation then  -- was commented
                            math[korientation] = orientation
                        end                                   -- was commented
                    end
                end
            end
            -- There are quite some fonts out there (noto anno 2024) with these so we only report the
            -- number. It's often the first entry then.
            if n > 0 then
                report("discarding %i self referencing %s variant entries",n,orientation)
            end
            -- There are a few fonts out there (noto anno 2024) that have a variant list with entries
            -- that themselve have variants and that gives circular references in a 'next' chain.
            for index=1,#glyphs do
                local g = glyphs[index]
                local m = g.math
                if m then
                    local v = m[kvariants]
                    if v then
                        local done = { [index] = true }
                        local size = #v
                        local i    = 1
                        while i <= size do
                            local vi = v[i]
                            if done[vi] then
                                report("discarding %sdirect circular %s variant index 0x%04X for index 0x%04X, %C","",orientation,vi,index,tonumber(g.unicode) or 0xFFFD)
                                table.remove(v,i)
                                size = size - 1
                                goto NEXT
                            else
                                local gg = glyphs[vi]
                                if gg then
                                    local mm = gg.math
                                    if mm then
                                        local vv = mm[kvariants]
                                        if vv then
                                            report("discarding %sdirect circular %s variant index 0x%04X for index 0x%04X, %C","in",orientation,vi,index,tonumber(g.unicode) or 0xFFFD)
                                            table.remove(v,i)
                                            size = size - 1
                                            goto NEXT
                                        end
                                    end
                                end
                                done[vi] = true
                            end
                            i = i + 1
                          ::NEXT::
                        end
                    end
                end
            end
        end
    end
    get(offset,hcoverage,hnofglyphs,hconstruction,"variants","parts","partsitalic","partsorientation","horizontal")
    get(offset,vcoverage,vnofglyphs,vconstruction,"variants","parts","partsitalic","partsorientation","vertical")
end

function readers.math(f,fontdata,specification)
    local tableoffset = gotodatatable(f,fontdata,"math",specification.glyphs)
    if tableoffset then
        local getdelta       = fontdata.temporary and fontdata.temporary.getdelta
        local getdevice      = setdevicecallback(fontdata,specification)
        local version = readulong(f)
     -- if version ~= 0x00010000 then
     --     report("table version %a of %a is not supported (yet), maybe font %s is bad",version,"math",fontdata.filename)
     --     return
     -- end
        local constants = readushort(f)
        local glyphinfo = readushort(f)
        local variants  = readushort(f)
        if constants == 0 then
            report("the math table of %a has no constants",fontdata.filename)
        else
            readmathconstants(f,fontdata,tableoffset+constants,getdelta,getdevice)
        end
        if glyphinfo ~= 0 then
            readmathglyphinfo(f,fontdata,tableoffset+glyphinfo,getdelta,getdevice)
        end
        if variants ~= 0 then
            readmathvariants(f,fontdata,tableoffset+variants,getdelta,getdevice)
        end
    end
end

do

    -- format 1: PaintColrLayers
    --     for each referenced child paint table, in bottom-up z-order:
    --         call renderPaint() passing the child paint table
    --         compose the returned graphic onto the surface using simplealpha blending
    --
    -- format 2, 3: PaintSolid
    --     paint the specified color onto the surface
    --
    -- format 4, 5, 6, 7, 8, 9: PaintLinearGradient, PaintRadialGradient, PaintSweepGradient
    --     paint the gradient onto the surface following the gradient algorithm
    --
    -- format 10: PaintGlyph
    --     apply the outline of the referenced glyph to the clip region
    --     (take the intersection of clip regions—see Filling shapes)
    --     call renderPaint() passing the child paint table
    --     restore the previous clip region
    --
    -- format 11: PaintColrGlyph
    --     call renderPaint() passing the paint table referenced by the base glyph ID
    --
    -- format 12 .. 31: Transform Translate Scale
    --     apply the specified transform, compose the transform with the current transform
    --     call renderPaint() passing the child paint table
    --     restore the previous transform state
    --
    -- format 32: PaintComposite
    --     call renderPaint() passing the backdrop child paint table and save the result
    --     call renderPaint() passing the source child paint table and save the result
    --     compose the source and backdrop using the specified composite mode
    --     compose the result of the above composition onto the surface using simple alpha blending

    local paintdata  -- for the moment verbose, will be just indexed
    local linesdata  -- for the moment verbose, will be just indexed
    local affinedata -- for the moment verbose, will be just indexed
    local clipdata   -- clipList records, indexed by glyph range
    local colrmap
    local colrdeltas
    local colrregions
    local layerlistoffset
    local layeroffset

    local function getpaintoffset(f,offset)
        local o = readuoffset(f)
        if o == 0 then
            return nil
        else
            -- Paint offsets are relative to the beginning of the current
            -- Paint table. Keep references as offsets until the tables are
            -- compacted below; storing the decoded table here breaks shared
            -- references during rehashing.
            local target = offset + o
            if paintdata then
                local child = paintdata[target] -- force decoding of the reachable child
            end
            return target
        end
    end

    local function getlinesoffset(f,offset,var)
        local relative = readuoffset(f)
        if relative == 0 then
            return nil
        end
        local absolute = offset + relative
        if linesdata[absolute] == nil then
            linesdata[absolute] = var
        elseif var then
            linesdata[absolute] = true
        end
        return absolute
    end

    local function getaffineoffset(f,offset,var)
        local relative = readuoffset(f)
        if relative == 0 then
            return nil
        end
        local absolute = offset + relative
        if affinedata[absolute] == nil then
            affinedata[absolute] = var
        elseif var then
            affinedata[absolute] = true
        end
        return absolute
    end

    local function readcolrindexmap(f,offset)
        if not offset or offset == 0 then
            return nil
        end
        setposition(f,offset)
        -- COLR uses the current DeltaSetIndexMap definition: unlike the
        -- older HVAR/VVAR form, format and entryFormat are separate bytes
        local format      = readuinteger(f)
        local entryformat = readuinteger(f)
        local count       = format == 0 and readushort(f) or readulong(f)
        local entrysize   = (((entryformat & 0x30) >> 4) & 0x03) + 1
        local innerbits   = (entryformat & 0x0F) + 1
        local innermask   = (1 << innerbits) - 1
        local reader      = read_cardinal[entrysize]
        if not reader then
            return nil
        end
        local map = { }
        for i=0,count-1 do
            local value = reader(f)
            map[i] = {
                outer = (value >> innerbits) & 0xFFFFFFFF,
                inner = value & innermask,
            }
        end
        map.format      = format
        map.entryformat = entryformat
        map.count       = count
        return map
    end

    local function colrdelta(base,index,scale)
        if not colrdeltas or not colrregions or not base or base == 0xFFFFFFFF then
            return 0
        end
        local entry = colrmap and colrmap[base + index]
        if not entry then
            if colrmap and colrmap.count and colrmap.count > 0 then
                entry = colrmap[colrmap.count-1]
            else
                -- With no mapping table, the varIndexBase sequence is an
                -- implicit sequence of 16.16 delta-set indices.
                local value = base + index
                entry = {
                    outer = (value >> 16) & 0xFFFF,
                    inner = value & 0xFFFF,
                }
            end
        end
        local variation = colrdeltas[entry.outer+1]
        local values    = variation and variation.deltas[entry.inner+1]
        if not values then
            return 0
        end
        local scales = variation.scales
        if not scales then
            return 0
        end
        local delta = 0
        for i=1,#scales do
            local value = values[i]
            if value then
                delta = delta + scales[i] * value
            else
                break
            end
        end
        return delta * (scale or 1)
    end

    local function adjustcolr(record,field,base,index,scale,integer)
        if record and record[field] ~= nil and base then
            local value = record[field] + colrdelta(base,index,scale)
            record[field] = type(integer) == "function" and integer(value) or integer and round(value) or value
        end
    end

    local paintreaders = {
        -- uint8    numLayers           Number of offsets to paint tables to read from LayerList.
        -- uint32   firstLayerIndex     Index (base 0) into the LayerList.
       [1] = function(f,format)
           return {
               format = format,
               name   = "PaintColrLayers",
               count  = readuinteger(f),
               index  = readulong(f),
               list   = false,
           }
       end,
       -- uint16   paletteIndex        Index for a CPAL palette entry.
       -- F2DOT14  alpha               Alpha value.
       [2] = function(f,format)
           return {
               format  = format,
               name    = "Paintsolid",
               palette = readushort(f),
               alpha   = read2dot14(f),
           }
       end,
       -- uint16   paletteIndex        Index for a CPAL palette entry.
       -- F2DOT14  alpha               Alpha value. For variation, use varIndexBase + 0.
       -- uint32   varIndexBase        Base index into DeltaSetIndexMap.
       [3] = function(f,format)
           return {
               format  = format,
               name    = "Paintsolid",
               palette = readushort(f),
               alpha   = read2dot14(f),
               varbase = readulong(f),
           }
       end,
       -- Offset24 colorLineOffset     Offset to VarColorLine table.
       -- FWORD    x0                  Start point (p₀) x coordinate. For variation, use varIndexBase + 0.
       -- FWORD    y0                  Start point (p₀) y coordinate. For variation, use varIndexBase + 1.
       -- FWORD    x1                  End point (p₁) x coordinate. For variation, use varIndexBase + 2.
       -- FWORD    y1                  End point (p₁) y coordinate. For variation, use varIndexBase + 3.
       -- FWORD    x2                  Rotation point (p₂) x coordinate. For variation, use varIndexBase + 4.
       -- FWORD    y2                  Rotation point (p₂) y coordinate. For variation, use varIndexBase + 5.
       -- uint32   varIndexBase        Base index into DeltaSetIndexMap.
       [4] = function(f,format,offset)
           return {
               format = format,
               name   = "PaintLinearGradient",
               color  = getlinesoffset(f,offset,false),
               x0     = readfword(f),
               y0     = readfword(f),
               x1     = readfword(f),
               y1     = readfword(f),
               x2     = readfword(f),
               y2     = readfword(f),
           }
       end,
       [5] = function(f,format,offset)
           return {
               format  = format,
               name    = "PaintLinearGradient",
               color   = getlinesoffset(f,offset,true),
               x0      = readfword(f),
               y0      = readfword(f),
               x1      = readfword(f),
               y1      = readfword(f),
               x2      = readfword(f),
               y2      = readfword(f),
               varbase = readulong(f),
           }
       end,
       -- Offset24 colorLineOffset     Offset to VarColorLine table.
       -- FWORD    x0                  Start circle center x coordinate. For variation, use varIndexBase + 0.
       -- FWORD    y0                  Start circle center y coordinate. For variation, use varIndexBase + 1.
       -- UFWORD   radius0             Start circle radius. For variation, use varIndexBase + 2.
       -- FWORD    x1                  End circle center x coordinate. For variation, use varIndexBase + 3.
       -- FWORD    y1                  End circle center y coordinate. For variation, use varIndexBase + 4.
       -- UFWORD   radius1             End circle radius. For variation, use varIndexBase + 5.
       -- uint32   varIndexBase        Base index into DeltaSetIndexMap.
