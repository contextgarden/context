local function setmetrics(data,where,tag,d)
    local w = data[where]
    if w then
        local v = w[tag]
        w[tag] = (v or 0) + d
    end
end

local function setgasp(data,index,d)
    local gasp   = data.gasp
    local ranges = gasp and gasp.ranges
    local range  = ranges and ranges[index]
    if range then
        range.maxPPEM = (range.maxPPEM or 0) + d
    end
end

