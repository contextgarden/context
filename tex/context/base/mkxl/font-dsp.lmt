    local unsupported = function()
        return false
    end

    setmetatableindex(paintreaders,function(t,format)
        if format then
            report("unsupported colr type 2 paint format %S",format)
            t[format] = unsupported -- problem: we don't know what to skip, so maybe best is to quit
        else
            report("possible error reading colr type 2 paint format")
        end
        return unsupported
    end)

    function readers.colr(f,fontdata,specification)
        local tableoffset = gotodatatable(f,fontdata,"colr",specification.glyphs)
        if tableoffset then
            paintdata, linesdata, affinedata, clipdata = nil, nil, nil, nil
            colrmap, colrdeltas, colrregions = nil, nil, nil
            local version = readushort(f)
            if version == 0 then
                -- we're okay
            elseif version == 1 then
                report("table version %a of %a is %s supported for font %s",version,"colr","partially",fontdata.filename)
            else
                report("table version %a of %a is %s supported for font %s",version,"colr","not",fontdata.filename)
                return
            end
            if not fontdata.tables.cpal then
                report("color table %a in font %a has no mandate %a table","colr",fontdata.filename,"cpal")
                return
            end
            local glyphs            = fontdata.glyphs
            local nofglyphs         = readushort(f)
            local baseoffset        = readulong(f)
            layeroffset             = readulong(f)
            local noflayers         = readushort(f)
            local glyphlistoffset   = 0
            layerlistoffset         = 0
            local cliplistoffset    = 0
            local varindexmapoffset = 0
            local variationoffset   = 0
            if version == 1 then
                glyphlistoffset   = readulong(f)
                layerlistoffset   = readulong(f)
                cliplistoffset    = readulong(f)
                varindexmapoffset = readulong(f)
                variationoffset   = readulong(f)
            end
            local layerrecords = { }
            local maxclass     = 0
            -- The special value 0xFFFF is foreground (but we index from 1). It
            -- more looks like indices into a palette so 'class' is a better name
            -- than 'palette'.
            if layeroffset > 0 and noflayers > 0 then
                setposition(f,tableoffset + layeroffset)
                for i=1,noflayers do
                    local slot  = readushort(f)
                    local class = readushort(f)
                    if class < 0xFFFF then
                        class = class + 1
                        if class > maxclass then
                            maxclass = class
                        end
                    end
                    layerrecords[i] = {
                        slot  = slot,
                        class = class,
                    }
                end
            end
            fontdata.maxcolorclass = maxclass
            if baseoffset > 0 and nofglyphs > 0 then
                setposition(f,tableoffset + baseoffset)
                for i=0,nofglyphs-1 do
                    local glyphindex = readushort(f)
                    local firstlayer = readushort(f)
                    local noflayers  = readushort(f)
                    if noflayers > 0 then
                        local t = { }
                        local g = glyphs[glyphindex]
                        if g then
                            for i=1,noflayers do
                                t[i] = layerrecords[firstlayer+i]
                            end
                            g.colors = t
                        end
                        -- This is a catch for an emoji fonts where the base glyph has no dimensions and
                        -- I admit that it's bad to fix this here instead of the font. But for sure someone
                        -- will argue that the font is ok, as one can use ascender and descender for height
                        -- and depth, but in tex we want granularity and exact dimensions.
                        local b = g and g.boundingbox
                        if g and (not b or (b[1] == 0 and b[2] == 0 and b[3] == 0 and b[4] == 0)) then
                            local llx, lly, urx, ury
                            for i=1,noflayers do
                                local c = glyphs[t[i].slot]
                                if c then
                                    b = c.boundingbox
                                    if b then
                                        local b1 = b[1]
                                        local b2 = b[2]
                                        local b3 = b[3]
                                        local b4 = b[4]
                                        if not llx then
                                            llx = b1
                                            lly = b2
                                            urx = b3
                                            ury = b4
                                        else
                                            if b1 < llx then llx = b1 end
                                            if b2 < lly then lly = b2 end
                                            if b3 > urx then urx = b3 end
                                            if b4 > ury then ury = b4 end
                                        end
                                    end
                                end
                            end
                            if llx then
                                g.boundingbox = { llx, lly, urx, ury }
                            end
                        end
                    end
                end
            end
            if next(layerrecords) then
                report("table version %a of %a contains both legacy and paint data for font %s",version,"colr",fontdata.filename)
            end
         -- if true then
         --     return
         -- end
            if glyphlistoffset > 0 then
                local layers = { }
                local paints = { }
                local layercount = 0
                if layerlistoffset > 0 then
                    layeroffset = tableoffset + layerlistoffset
                    setposition(f,layeroffset)
                    layercount = readulong(f)
                 -- layers = readcardinaltable(f,layercount,uoffset)
                    for i=1,layercount do -- zero ?
                        layers[i] = readulong(f) -- offsets to painttable
                    end
                end
                --
                local glyphoffset = tableoffset + glyphlistoffset
                setposition(f,glyphoffset)
                local glyphcount = readulong(f)
                for i=1,glyphcount do
                    -- The Paint offset is relative to the beginning of the
                    -- BaseGlyphList table.
                    local glyph       = readushort(f)
                    local paintoffset = readulong(f)
                    paints[glyph] = glyphoffset + paintoffset
                end
                paintdata = setmetatableindex(function(t,k)
                    local p = getposition(f)
                    setposition(f,k)
                    local format = readuinteger(f)
                    local v = paintreaders[format](f,format,k)
                    setposition(f,p)
                    t[k] = v
                    return v
                end)
                linesdata  = { }
                affinedata = { }
                for i=1,layercount do -- zero ?
                    local o = layeroffset + layers[i]
                    local l = paintdata[o]
                    if not l then
                        report("color table in font %a has an invalid layer entry %i, offset %i",i,layers[i])
                    end
                    layers[i] = l and o or nil
                end
                for k, v in next, paints do
                    if paintdata[v] then
                        paints[k] = v -- first paint
                    end
                end
                -- expand format 1
                for k, v in next, paints do
                    v = paintdata[v]
                    if v then
                        local format = v.format
                        if format == 1 then
                            -- name
                            local count = v.count
                            if count then
                                local index = v.index + 1
                                local list  = { }
                                v.count = nil
                                v.index = nil
                                v.list  = list
                                for i=1,count do
                                    list[i] = layers[index]
                                    index = index + 1
                                end
                            else
                                -- already done
                            end
                        end
                    else
                        -- missing
                    end
                end
                --
                if variationoffset > 0 then
                    local offsettostore = tableoffset + variationoffset
                    colrregions, colrdeltas = readvariationdata(f,offsettostore,specification.factors)
                end
                if varindexmapoffset > 0 then
                    colrmap = readcolrindexmap(f,tableoffset + varindexmapoffset)
                end
                setvariabledata(fontdata,"colr",{
                    regions = colrregions,
                    deltas  = colrdeltas,
                    map     = colrmap,
                })
                -- ClipList records are ranges of glyph IDs. ClipBox format 2
                -- adds a VarIndexBase; format 1 is the fixed form.
                if cliplistoffset > 0 then
                    local clipoffset = tableoffset + cliplistoffset
                    setposition(f,clipoffset)
                    local clipformat = readuinteger(f)
                    local nofclips   = readulong(f)
                    if clipformat == 1 then
                        clipdata = { format = clipformat }
                        for i=1,nofclips do
                            local first     = readushort(f)
                            local last      = readushort(f)
                            local boxoffset = readuoffset(f)
                            local box
                            if boxoffset ~= 0 then
                                local position = getposition(f)
                                setposition(f,clipoffset + boxoffset)
                                local format = readuinteger(f)
                                if format == 1 then
                                    box = {
                                        format = format,
                                        xmin   = readshort(f),
                                        ymin   = readshort(f),
                                        xmax   = readshort(f),
                                        ymax   = readshort(f),
                                    }
                                elseif format == 2 then
                                    box = {
                                        format  = format,
                                        xmin    = readshort(f),
                                        ymin    = readshort(f),
                                        xmax    = readshort(f),
                                        ymax    = readshort(f),
                                        varbase = readulong(f),
                                    }
                                end
                                setposition(f,position)
                            end
                            clipdata[i] = {
                                first = first,
                                last  = last,
                                box   = box,
                            }
                        end
                    else
                        report("unsupported ClipList format %a in font %a",clipformat,fontdata.filename)
                    end
                end
                --
                -- reindex tables, gives smaller files but optional because of tracing
                --
                for k, v in next, linesdata do
                    setposition(f,k)
                    local extend = readuinteger(f)
                    local count  = readushort(f)
                    local stops  = { }
                    if count then
                        for i=1,count do
                            stops[i] = {
                                stop     = read2dot14(f),
                                palette  = readushort(f),
                                alpha    = read2dot14(f),
                                varbase  = v and readulong(f) or nil,
                            }
                        end
                        linesdata[k] = {
                            extend = extend,
                            stops  = stops,
                        }
                    else
                        report("running out of linedata in colr reading")
                        linesdata[k] = {
                            extend = 0,
                            stops  = stops,
                        }
                        break
                    end
                end
                --
                for k, v in next, affinedata do
                    setposition(f,k)
                    affinedata[k] = {
                        xx      = readfixed(f),
                        yx      = readfixed(f),
                        xy      = readfixed(f),
                        yy      = readfixed(f),
                        dx      = readfixed(f),
                        dy      = readfixed(f),
                        varbase = v and readulong(f) or nil,
                    }
                end
                --
                if colrdeltas then
                    local function adjustpaint(p)
                        if not p then
                            return
                        end
                        local base = p.varbase
                        if base then
                            local format = p.format
                            if format == 3 then
                                adjustcolr(p,"alpha",base,0,1/16384)
                            elseif format == 5 then
                                adjustcolr(p,"x0",base,0,1,true)
                                adjustcolr(p,"y0",base,1,1,true)
                                adjustcolr(p,"x1",base,2,1,true)
                                adjustcolr(p,"y1",base,3,1,true)
                                adjustcolr(p,"x2",base,4,1,true)
                                adjustcolr(p,"y2",base,5,1,true)
                            elseif format == 7 then
                                adjustcolr(p,"x0",base,0,1,true)
                                adjustcolr(p,"y0",base,1,1,true)
                                adjustcolr(p,"radius0",base,2,1,true)
                                adjustcolr(p,"x1",base,3,1,true)
                                adjustcolr(p,"y1",base,4,1,true)
                                adjustcolr(p,"radius1",base,5,1,true)
                            elseif format == 9 then
                                adjustcolr(p,"centerx",base,0,1,true)
                                adjustcolr(p,"centery",base,1,1,true)
                                adjustcolr(p,"startangle",base,2,1/16384)
                                adjustcolr(p,"endangle",base,3,1/16384)
                            elseif format == 15 then
                                adjustcolr(p,"dx",base,0,1,true)
                                adjustcolr(p,"dy",base,1,1,true)
                            elseif format == 17 then
                                adjustcolr(p,"scalex",base,0,1/16384)
                                adjustcolr(p,"scaley",base,1,1/16384)
                            elseif format == 19 then
                                adjustcolr(p,"scalex",base,0,1/16384)
                                adjustcolr(p,"scaley",base,1,1/16384)
                                adjustcolr(p,"centerx",base,2,1,true)
                                adjustcolr(p,"centery",base,3,1,true)
                            elseif format == 21 then
                                adjustcolr(p,"scale",base,0,1/16384)
                            elseif format == 23 then
                                adjustcolr(p,"scale",base,0,1/16384)
                                adjustcolr(p,"centerx",base,1,1,true)
                                adjustcolr(p,"centery",base,2,1,true)
                            elseif format == 25 then
                                adjustcolr(p,"angle",base,0,1/16384)
                            elseif format == 27 then
                                adjustcolr(p,"angle",base,0,1/16384)
                                adjustcolr(p,"centerx",base,1,1,true)
                                adjustcolr(p,"centery",base,2,1,true)
                            elseif format == 29 then
                                adjustcolr(p,"xangle",base,0,1/16384)
                                adjustcolr(p,"yangle",base,1,1/16384)
                            elseif format == 31 then
                                adjustcolr(p,"xangle",base,0,1/16384)
                                adjustcolr(p,"yangle",base,1,1/16384)
                                adjustcolr(p,"centerx",base,2,1,true)
                                adjustcolr(p,"centery",base,3,1,true)
                            end
                        end
                    end
                    for _, paint in next, paintdata do
                        adjustpaint(paint)
                    end
                    for _, line in next, linesdata do
                        if type(line) == "table" then
                            for i=1,#line.stops do
                                local stop = line.stops[i]
                                if stop.varbase then
                                    stop.stop  = stop.stop  + colrdelta(stop.varbase,0,1/16384)
                                    stop.alpha = stop.alpha + colrdelta(stop.varbase,1,1/16384)
                                end
                            end
                        end
                    end
                    for _, affine in next, affinedata do
                        if type(affine) == "table" and affine.varbase then
                            adjustcolr(affine,"xx",affine.varbase,0,1/65536)
                            adjustcolr(affine,"yx",affine.varbase,1,1/65536)
                            adjustcolr(affine,"xy",affine.varbase,2,1/65536)
                            adjustcolr(affine,"yy",affine.varbase,3,1/65536)
                            adjustcolr(affine,"dx",affine.varbase,4,1/65536)
                            adjustcolr(affine,"dy",affine.varbase,5,1/65536)
                        end
                    end
                    if clipdata then
                        for i=1,#clipdata do
                            local box = clipdata[i].box
                            if box and box.varbase then
                                adjustcolr(box,"xmin",box.varbase,0,1,floor)
                                adjustcolr(box,"ymin",box.varbase,1,1,floor)
                                adjustcolr(box,"xmax",box.varbase,2,1,ceil)
                                adjustcolr(box,"ymax",box.varbase,3,1,ceil)
                            end
                        end
                    end
                end
                --
                local function rehash(t)
                    local hash = { }
                    local data = { }
                    local n     = 0
                    for k, v in sortedhash(t) do
                        n = n + 1
                        hash[k] = n
                        data[n] = v
                    end
                    return hash, data
                end
                --
                if true then
                    local phash, pdata = rehash(paintdata)
                    local lhash, ldata = rehash(linesdata)
                    local ahash, adata = rehash(affinedata)
                    for k, v in next, paintdata do
                        if v then
                            local c = v.color
                            if c then
                                v.color = lhash[c]
                            end
                            local a = v.affine
                            if a then
                                v.affine = ahash[a]
                            end
                            local p = v.paint
                            if p then
                                v.paint = phash[p]
                            end
                            local l = v.list
                            if l then
                                for i=1,#l do
                                    l[i] = phash[l[i]]
                                end
                            end
                            local s = v.source
                            if s then
                                v.source   = phash[s]
                                v.backdrop = phash[v.backdrop]
                            end
                        end
                    end
                    paintdata  = pdata
                    linesdata  = ldata
                    affinedata = adata
                    for k, v in next, paints do -- zero indexed
                        paints[k] = phash[v]
                    end
                end
                --
                if next(paints) then
                    local function paletteof(index,seen)
                        local paint = index and paintdata[index]
                        if not paint then
                            return nil
                        end
                        local format = paint.format
                        if format == 2 or format == 3 then
                            return paint.palette
                        elseif format == 11 then
                            seen = seen or { }
                            if seen[paint.glyph] then
                                return nil
                            end
                            seen[paint.glyph] = true
                            return paletteof(paints[paint.glyph],seen)
                        elseif paint.paint then
                            return paletteof(paint.paint,seen)
                        elseif paint.source then
                            return paletteof(paint.source,seen) or paletteof(paint.backdrop,seen)
                        end
                    end
                    local function collect(index,done,seen)
                        local paint = index and paintdata[index]
                        if not paint then
                            return
                        end
                        local format = paint.format
                        if format == 1 then
                            local list = paint.list
                            if list then
                                for i=1,#list do
                                    collect(list[i],done,seen)
                                end
                            end
                        elseif format == 10 then
                            local palette = paletteof(paint.paint)
                            done[#done+1] = {
                                slot  = paint.glyph,
                                class = palette and (palette == 0xFFFF and 0xFFFF or palette + 1) or 1,
                            }
                        elseif format == 11 then
                            local glyph = paint.glyph
                            seen = seen or { }
                            if not seen[glyph] then
                                seen[glyph] = true
                                collect(paints[glyph],done,seen)
                            end
                        end
                    end
                    for k, v in next, paints do
                        local paint  = paintdata[v]
                        if paint and paint.format == 1 then
                            local done = { }
                            collect(v,done,{ })
                            local glyph = glyphs[k]
                            if glyph then
                                glyph.colors = done
                            end
                        elseif paint and paint.format == 11 then
                            local done = { }
                            collect(v,done,{ })
                            if #done > 0 then
                                local glyph = glyphs[k]
                                if glyph then
                                    glyph.colors = done
                                end
                            end
                        end
                    end
                end
                fontdata.colorpaintdata  = paintdata
                fontdata.colorpaintlist  = paints
                fontdata.colorlinesdata  = linesdata
                fontdata.coloraffinedata = affinedata
                fontdata.colorclips      = clipdata
            end
        end
      ::done::
        fontdata.hascolor = true
    end

end

function readers.cpal(f,fontdata,specification)
    local tableoffset = gotodatatable(f,fontdata,"cpal",specification.glyphs)
    if tableoffset then
        local version = readushort(f)
     -- if version > 1 then
     --     report("table version %a of %a is not supported (yet), maybe font %s is bad",version,"cpal",fontdata.filename)
     --     return
     -- end
        local nofpaletteentries  = readushort(f)
        local nofpalettes        = readushort(f)
        local nofcolorrecords    = readushort(f)
        local firstcoloroffset   = readulong(f)
        local colorrecords       = { }
        local palettes           = readcardinaltable(f,nofpalettes,ushort)
        local palettetypesoffset
        local palettelabelsoffset
        local paletteentryoffset
        if version >= 1 then
            -- CPAL v1 adds palette usage flags and name IDs. The offsets are
            -- relative to the beginning of CPAL and may be NULL.
            palettetypesoffset  = readulong(f)
            palettelabelsoffset = readulong(f)
            paletteentryoffset  = readulong(f)
        end
        setposition(f,tableoffset+firstcoloroffset)
        for i=1,nofcolorrecords do
            local b, g, r, a = readbytes(f,4)
            colorrecords[i] = {
                r, g, b, a ~= 255 and a or nil,
            }
        end
        for i=1,nofpalettes do
            local p = { }
            local o = palettes[i]
            for j=1,nofpaletteentries do
                p[j] = colorrecords[o+j]
            end
            palettes[i] = p
        end
        fontdata.colorpalettes = palettes
        if version >= 1 then
            local info = { version = version }
            if palettetypesoffset and palettetypesoffset ~= 0 then
                setposition(f,tableoffset+palettetypesoffset)
                local types = { }
                for i=1,nofpalettes do
                    types[i] = readulong(f)
                end
                info.paletteTypes = types
            end
            if palettelabelsoffset and palettelabelsoffset ~= 0 then
                setposition(f,tableoffset+palettelabelsoffset)
                local labels = { }
                for i=1,nofpalettes do
                    labels[i] = readushort(f)
                end
                info.paletteLabels = labels
            end
            if paletteentryoffset and paletteentryoffset ~= 0 then
                setposition(f,tableoffset+paletteentryoffset)
                local labels = { }
                for i=1,nofcolorrecords do
                    labels[i] = readushort(f)
                end
                info.entryLabels = labels
            end
            fontdata.colorpaletteinfo = info
        end
    end
end

local compress   = gzip     and gzip.compress
local compressed = compress and gzip.compressed

-- At some point I will delay loading and only store the offsets.

-- compressed = false

function readers.svg(f,fontdata,specification)
    local tableoffset = gotodatatable(f,fontdata,"svg",specification.glyphs)
    if tableoffset then
        local version = readushort(f)
     -- if version ~= 0 then
     --     report("table version %a of %a is not supported (yet), maybe font %s is bad",version,"svg",fontdata.filename)
     --     return
     -- end
        local glyphs      = fontdata.glyphs
        local indexoffset = tableoffset + readulong(f)
        local reserved    = readulong(f)
        setposition(f,indexoffset)
        local nofentries  = readushort(f)
        local entries     = { }
        for i=1,nofentries do
            entries[i] = {
                first  = readushort(f),
                last   = readushort(f),
                offset = indexoffset + readulong(f),
                length = readulong(f),
            }
        end
        for i=1,nofentries do
            local entry = entries[i]
            setposition(f,entry.offset)
            local data = readstring(f,entry.length)
            if compressed and not compressed(data) then
                data = compress(data)
            end
            entries[i] = {
                first = entry.first,
                last  = entry.last,
                data  = data
            }
        end
        fontdata.svgshapes = entries
        fontdata.hascolor  = true
    end
end

function readers.sbix(f,fontdata,specification)
    local tableoffset = gotodatatable(f,fontdata,"sbix",specification.glyphs)
    if tableoffset then
        local version    = readushort(f)
        local flags      = readushort(f)
        local nofstrikes = readulong(f)
        local strikes    = { }
        local nofglyphs  = fontdata.nofglyphs
        for i=1,nofstrikes do
            strikes[i] = readulong(f)
        end
        local shapes = { }
        local done   = 0
        for i=1,nofstrikes do
            local strikeoffset = strikes[i] + tableoffset
            setposition(f,strikeoffset)
            strikes[i] = {
                ppem   = readushort(f),
                ppi    = readushort(f),
                offset = strikeoffset
            }
        end
        -- highest first
        sort(strikes,function(a,b)
            if b.ppem == a.ppem then
                return b.ppi < a.ppi
            else
                return b.ppem < a.ppem
            end
        end)
        local glyphs  = { }
     -- local delayed = fonts.handlers.typethree
        for i=1,nofstrikes do
            local strike       = strikes[i]
            local strikeppem   = strike.ppem
            local strikeppi    = strike.ppi
            local strikeoffset = strike.offset
            setposition(f,strikeoffset)
            for i=0,nofglyphs do
                glyphs[i] = readulong(f)
            end
            local glyphoffset = glyphs[0]
            for i=0,nofglyphs-1 do
                local nextoffset = glyphs[i+1]
                if not shapes[i] then
                    local datasize = nextoffset - glyphoffset
                    if datasize > 0 then
                        setposition(f,strikeoffset + glyphoffset)
                        local x      = readshort(f)
                        local y      = readshort(f)
                        local tag    = readtag(f) -- or just skip, we never needed it till now
                        local size   = datasize - 8
                        local data   = nil
                        local offset = nil
                     -- if delayed then
                            offset = getposition(f)
                     -- else
                     --     data   = readstring(f,size)
                     --     size   = nil
                     -- end
                        shapes[i] = {
                            x    = x,
                            y    = y,
                            o    = offset,
                            s    = size,
                            data = data,
                         -- tag  = tag, -- maybe for tracing
                         -- ppem = strikeppem, -- not used, for tracing
                         -- ppi  = strikeppi,  -- not used, for tracing
                        }
                        done = done + 1
                        if done == nofglyphs then
                            break
                        end
                    end
                end
                glyphoffset = nextoffset
            end
        end
        fontdata.pngshapes = shapes
        fontdata.hascolor  = true
    end
end

-- Another bitmap (so not that useful) format. But Luigi found a font that
-- has them , so ...

do

    local function getmetrics(f)
        return {
            ascender              = readinteger(f),
            descender             = readinteger(f),
            widthmax              = readuinteger(f),
            caretslopedumerator   = readinteger(f),
            caretslopedenominator = readinteger(f),
            caretoffset           = readinteger(f),
            minorigin             = readinteger(f),
            minadvance            = readinteger(f),
            maxbefore             = readinteger(f),
            minafter              = readinteger(f),
            pad1                  = readinteger(f),
            pad2                  = readinteger(f),
        }
    end

    -- bad names

    local function getbigmetrics(f)
        -- bigmetrics, maybe just skip 9 bytes
        return {
            height       = readuinteger(f),
            width        = readuinteger(f),
            horiBearingX = readinteger(f),
            horiBearingY = readinteger(f),
            horiAdvance  = readuinteger(f),
            vertBearingX = readinteger(f),
            vertBearingY = readinteger(f),
            vertAdvance  = readuinteger(f),
        }
    end

    local function getsmallmetrics(f)
        -- smallmetrics, maybe just skip 5 bytes
        return {
            height   = readuinteger(f),
            width    = readuinteger(f),
            bearingX = readinteger(f),
            bearingY = readinteger(f),
            advance  = readuinteger(f),
        }
    end

    local function readbitmapfont(f,fontdata,specification,locatortag,datatag)
        local shapesfield = datatag == "cbdt" and "pngshapes" or "bitmapshapes"
        if not specification.glyphs or fontdata[shapesfield] then
            return
        end
        local datatableoffset = gotodatatable(f,fontdata,datatag,specification.glyphs)
        local locatoroffset   = gotodatatable(f,fontdata,locatortag,specification.glyphs)
        if not datatableoffset or not locatoroffset then
            return
        end
        local majorversion  = readushort(f)
        local minorversion  = readushort(f)
        local nofsizetables = readulong(f)
        local sizetables    = { }
        local shapes        = { }
        local subtables     = { }
        for i=1,nofsizetables do
            sizetables[i] = {
                subtables    = readulong(f),
                indexsize    = readulong(f),
                nofsubtables = readulong(f),
                colorref     = readulong(f),
                hormetrics   = getmetrics(f),
                vermetrics   = getmetrics(f),
                firstindex   = readushort(f),
                lastindex    = readushort(f),
                ppemx        = readbyte(f),
                ppemy        = readbyte(f),
                bitdepth     = readbyte(f),
                flags        = readbyte(f),
            }
        end
        sort(sizetables,function(a,b)
            if b.ppemx == a.ppemx then
                return b.bitdepth < a.bitdepth
            else
                return b.ppemx < a.ppemx
            end
        end)
        for i=1,nofsizetables do
            local strike = sizetables[i]
            local used   = false
            for glyph= strike.firstindex, strike.lastindex do
                if not shapes[glyph] then
                    shapes[glyph] = i
                    used = true
                end
            end
            strike.used = used
        end
        for i=1,nofsizetables do
            local strike = sizetables[i]
            if strike.used then
                local arrayoffset = locatoroffset + strike.subtables
                setposition(f,arrayoffset)
                for j=1,strike.nofsubtables do
                    local firstindex     = readushort(f)
                    local lastindex      = readushort(f)
                    local relative       = readulong(f)
                    local subtableoffset = arrayoffset + relative
                    local subtable       = subtables[subtableoffset]
                    if not subtable then
                        subtable = {
                            firstindex = firstindex,
                            lastindex  = lastindex,
                            strike     = strike,
                        }
                        subtables[subtableoffset] = subtable
                    end
                    for glyph=firstindex,lastindex do
                        if shapes[glyph] == i then
                            shapes[glyph] = subtable
                        end
                    end
                end
            end
        end

        for offset, subtable in sortedhash(subtables) do
            setposition(f,offset)
            subtable.indexformat = readushort(f)
            subtable.format      = readushort(f)
            local imageoffset    = readulong(f)
            local baseoffset     = datatableoffset + imageoffset
            local offsets        = { }
            local ends           = { }
            local metrics        = nil
            local firstindex     = subtable.firstindex
            local lastindex      = subtable.lastindex
            if subtable.indexformat == 1 then
                local values = { }
                for i=0,lastindex-firstindex+1 do
                    values[i] = readulong(f)
                end
                for i=0,lastindex-firstindex do
                    local glyph = firstindex + i
                    offsets[glyph] = baseoffset + values[i]
                    ends   [glyph] = baseoffset + values[i+1]
                end
            elseif subtable.indexformat == 2 then
                local size = readulong(f)
                metrics = getbigmetrics(f)
                for glyph=firstindex,lastindex do
                    local offset = baseoffset + (glyph-firstindex) * size
                    offsets[glyph] = offset
                    ends   [glyph] = offset + size
                end
            elseif subtable.indexformat == 3 then
                local values = { }
                for i=0,lastindex-firstindex+1 do
                    values[i] = readushort(f)
                end
                for i=0,lastindex-firstindex do
                    local glyph = firstindex + i
                    offsets[glyph] = baseoffset + values[i]
                    ends   [glyph] = baseoffset + values[i+1]
                end
            elseif subtable.indexformat == 4 then
                local count = readulong(f)
                local previousglyph, previousoffset
                for i=1,count+1 do
                    local glyph = readushort(f)
                    local value = readushort(f)
                    if previousglyph then
                        offsets[previousglyph] = baseoffset + previousoffset
                        ends[previousglyph] = baseoffset + value
                    end
                    previousglyph, previousoffset = glyph, value
                end
            elseif subtable.indexformat == 5 then
                local size = readulong(f)
                subtable.imageSize = size
                metrics = getbigmetrics(f)
                local count = readulong(f)
                local glyphids = { }
                for i=1,count do
                    glyphids[i] = readushort(f)
                end
                if math.odd(count) then
                    skipbytes(f,2)
                end
                for i=1,count do
                    local glyph  = glyphids[i]
                    local offset = baseoffset + (i-1) * size
                    offsets[glyph] = offset
                    ends   [glyph] = offset + size
                end
            else
                report("unsupported %s index subtable format %a in font %a",locatortag,subtable.indexformat,fontdata.filename)
            end
            subtable.offsets = offsets
            subtable.ends    = ends
            subtable.metrics = metrics
        end

        local default = { width = 0, height = 0 }
        local glyphs  = fontdata.glyphs
        for index, subtable in sortedhash(shapes) do
            if type(subtable) == "table" then
                local start   = subtable.offsets and subtable.offsets[index]
                local finish  = subtable.ends and subtable.ends[index]
                local format  = subtable.format
                local metrics = subtable.metrics or default
                local bitmap  = true
                local payload, size, data, components
                if start then
                    setposition(f,start)
                    if format == 17 then
                        metrics = getsmallmetrics(f)
                        size    = readulong(f)
                        payload = getposition(f)
                    elseif format == 18 then
                        metrics = getbigmetrics(f)
                        size    = readulong(f)
                        payload = getposition(f)
                    elseif format == 19 then
                        size    = readulong(f)
                        payload = getposition(f)
                    elseif format == 1 then
                        metrics  = getsmallmetrics(f)
                        payload  = getposition(f)
                  local rowbytes = (metrics.width * subtable.strike.bitdepth + 7) // 8
                        size     = rowbytes * metrics.height
                    elseif format == 2 then
                        metrics = getsmallmetrics(f)
                        payload = getposition(f)
                        size     = (metrics.width * metrics.height * subtable.strike.bitdepth + 7) // 8
                    elseif format == 5 then
                        payload = start
                        size    = subtable.imageSize
                    elseif format == 6 then
                        metrics  = getbigmetrics(f)
                        payload  = getposition(f)
                  local rowbytes = (metrics.width * subtable.strike.bitdepth + 7) // 8
                        size     = rowbytes * metrics.height
                    elseif format == 7 then
                        metrics = getbigmetrics(f)
                        payload = getposition(f)
                        size = (metrics.width * metrics.height * subtable.strike.bitdepth + 7) // 8
                    elseif format == 8 then
                        metrics = getsmallmetrics(f)
                        skipbytes(f,1) -- padding
                        local count = readushort(f)
                        components = { }
                        for i=1,count do
                            components[i] = {
                                glyph = readushort(f),
                                x     = readinteger(f),
                                y     = readinteger(f),
                            }
                        end
                        payload, size, bitmap = start, (finish and finish-start or 0), false
                    elseif format == 9 then
                        metrics    = getbigmetrics(f)
                        components = { }
                        local count = readushort(f)
                        for i=1,count do
                            components[i] = {
                                glyph = readushort(f),
                                x     = readinteger(f),
                                y     = readinteger(f),
                            }
                        end
                        payload, size, bitmap = start, (finish and finish-start or 0), false
                    else
                        payload, size = start, finish and finish-start or 0
                    end
                    if finish and payload then
                        local available = finish - payload
                        if size > available then
                            size = available
                        end
                    end
                end
                local x = metrics.width or 0
                local y = metrics.height or 0
                shapes[index] = {
                    x          = x,
                    y          = y,
                    o          = payload,
                    s          = size,
                    data       = data,
                    format     = format,
                    metrics    = metrics,
                    components = components,
                    bitdepth   = subtable.strike.bitdepth,
                    bitmap     = bitmap,
                    ppem       = subtable.strike.ppemx,
                    ppi        = subtable.strike.ppemy,
                }
                local glyph = glyphs and glyphs[index]
                if glyph and not glyph.boundingbox and x > 0 and y > 0 then
                    local width = glyph.width or x
                    glyph.boundingbox = { 0, 0, width, width * y / x }
                end
            else
                shapes[index] = { x = 0, y = 0, data = "" }
            end
        end
        fontdata.bitmapstrikes = fontdata.bitmapstrikes or { }
        fontdata.bitmapstrikes[datatag] = sizetables
        fontdata.bitmapformats = fontdata.bitmapformats or { }
        fontdata.bitmapformats[datatag] = {
            majorversion = majorversion,
            minorversion = minorversion,
        }
        fontdata[shapesfield] = shapes
        if datatag == "cbdt" then
            fontdata.hascolor = true
        end
    end

    function readers.cblc(f,fontdata,specification)
        readbitmapfont(f,fontdata,specification,"cblc","cbdt")
    end

    function readers.cbdt(f,fontdata,specification)
        if not fontdata.pngshapes then
            readbitmapfont(f,fontdata,specification,"cblc","cbdt")
        end
    end

 -- function readers.eblc(f,fontdata,specification)
 --     readbitmapfont(f,fontdata,specification,"eblc","ebdt")
 --     if fontdata.tables.ebsc and not fontdata.bitmapscales then
 --         readers.ebsc(f,fontdata,specification)
 --     end
 -- end
 --
 -- function readers.ebdt(f,fontdata,specification)
 --     if not fontdata.bitmapshapes then
 --         readbitmapfont(f,fontdata,specification,"eblc","ebdt")
 --     end
 -- end
 --
 -- function readers.ebsc(f,fontdata,specification)
 --     if fontdata.bitmapscales then
 --         return
 --     end
 --     local tableoffset = gotodatatable(f,fontdata,"ebsc",specification.glyphs)
 --     if tableoffset then
 --         local version  = readulong(f)
 --         local nofsizes = readulong(f)
 --         local sizes    = { }
 --         for i=1,nofsizes do
 --             sizes[i] = {
 --                 ppemx           = readbyte(f),
 --                 ppemy           = readbyte(f),
 --                 substitutePpemx = readbyte(f),
 --                 substitutePpemy = readbyte(f),
 --             }
 --         end
 --         fontdata.bitmapscales = { version = version, sizes = sizes }
 --     end
 -- end

end

-- + AVAR : optional
-- + CFF2 : otf outlines
-- - CVAR : ttf hinting, not needed
-- + FVAR : the variations
-- + GVAR : ttf outline changes
-- + HVAR : horizontal changes
-- + MVAR : metric changes
-- + STAT : relations within fonts
-- + VVAR : vertical changes
--
-- * BASE : extra baseline adjustments
-- + GASP : range behavior and MVAR targets
-- + GDEF : classes, mark sets, attachments and carets
-- + GPOS : device and variation-index tables
-- + GSUB : new table
-- + NAME : 25 added

function readers.gasp(f,fontdata,specification)
    local tableoffset = gotodatatable(f,fontdata,"gasp",true)
    if tableoffset then
        local version = readushort(f)
        local nofranges = readushort(f)
        local ranges = { }
        for i=1,nofranges do
            ranges[i] = {
                maxPPEM = readushort(f),
                behavior = readushort(f),
            }
        end
        fontdata.gasp = {
            version = version,
            ranges  = ranges,
        }
    end
end

function readers.stat(f,fontdata,specification)
    local tableoffset = gotodatatable(f,fontdata,"stat",true) -- specification.variable
    if tableoffset then
        local extras       = fontdata.extras
        local version      = readulong(f) -- 0x00010000
        local axissize     = readushort(f)
        local nofaxis      = readushort(f)
        local axisoffset   = readulong(f)
        local nofvalues    = readushort(f)
        local valuesoffset = readulong(f)
        local fallbackname = version >= 0x00010001 and extras[readushort(f)] or nil
        local axis         = { }
        local values       = { }
        local combinations = { }
        setposition(f,tableoffset+axisoffset)
        for i=1,nofaxis do
            local tag = readtag(f)
            axis[i] = {
                tag      = tag,
                name     = lower(extras[readushort(f)] or tag),
                ordering = readushort(f), -- maybe gaps
                variants = { }
            }
            if axissize > 8 then
                skipbytes(f,axissize-8)
            end
        end
        -- flags:
        --
        -- 0x0001 : OlderSiblingFontAttribute
        -- 0x0002 : ElidableAxisValueName
        -- 0xFFFC : reservedFlags
        --
        setposition(f,tableoffset+valuesoffset)
        for i=1,nofvalues do
            values[i] = readushort(f)
        end
        for i=1,nofvalues do
            setposition(f,tableoffset + valuesoffset + values[i])
            local format  = readushort(f)
            local index, flags, name, value, variant
            if format == 4 then
                local nofaxes = readushort(f)
                flags = readushort(f)
                name  = lower(extras[readushort(f)] or "no name")
                value = readfixed(f)
                variant = {
                    flags = flags,
                    name  = name,
                    value = value,
                    axes  = { },
                }
                for j=1,nofaxes do
                    variant.axes[j] = {
                        axis  = readushort(f) + 1,
                        value = readfixed(f),
                    }
                end
                combinations[#combinations+1] = variant
            else
                index = readushort(f) + 1
                flags = readushort(f)
                name  = lower(extras[readushort(f)] or "no name")
                value = readfixed(f)
            end
            if format == 1 then
                variant = {
                    flags = flags,
                    name  = name,
                    value = value,
                }
            elseif format == 2 then
                variant = {
                    flags   = flags,
                    name    = name,
                    value   = value,
                    minimum = readfixed(f),
                    maximum = readfixed(f),
                }
            elseif format == 3 then
                variant = {
                    flags = flags,
                    name  = name,
                    value = value,
                    link  = readfixed(f),
                }
            end
            if format ~= 4 and variant and axis[index] then
                insert(axis[index].variants,variant)
            end
        end
        -- axisIndex values in format 4 refer to the design-axis record
        -- order, while axisOrdering is only a UI ordering hint. Sort a
        -- separate view and remap the explicit axis indices accordingly.
        local designaxis = { }
        for i=1,#axis do
            designaxis[i] = axis[i]
        end
        sort(designaxis,function(a,b)
            return a.ordering < b.ordering
        end)
        local axisorder = { }
        for i=1,#designaxis do
            axisorder[designaxis[i]] = i
        end
        for i=1,#combinations do
            local combination = combinations[i]
            for j=1,#combination.axes do
                local record = combination.axes[j]
                local a = axis[record.axis]
                record.axis = axisorder[a] or record.axis
                record.tag = a and a.tag or nil
            end
        end
        for i=1,#designaxis do
            local a = designaxis[i]
            sort(a.variants,function(a,b)
                return a.name < b.name
            end)
            a.ordering = nil
        end
        setvariabledata(fontdata,"designaxis",designaxis)
        setvariabledata(fontdata,"axisvalues",combinations)
        setvariabledata(fontdata,"fallbackname",fallbackname)
    end
end

-- The avar table is optional and used in combination with fvar. Given the detailed
-- explanation about bad values we expect the worst and do some checking.
--
--
-- There is a proposal for version 2 that does some combined factoring which might
-- or not might be more effcient. This is not yet part of the standard but Julius
-- wants to play with in anyway.

function readers.avar(f,fontdata,specification)
    local tableoffset = gotodatatable(f,fontdata,"avar",true) -- specification.variable
    if tableoffset then

        local function collect()
            local nofvalues = readushort(f)
            local values    = { }
            local lastfrom  = false
            local lastto    = false
            for i=1,nofvalues do
                local from = read2dot14(f)
                local to   = read2dot14(f)
                if lastfrom and from <= lastfrom then
                    -- ignore
                elseif lastto and to < lastto then
                    -- ignore
                else
                    values[#values+1] = { from, to }
                    lastfrom, lastto = from, to
                end
            end
            nofvalues = #values
            if nofvalues > 2 then
                local some = values[1]
                if some[1] == -1 and some[2] == -1 then
                    some = values[nofvalues]
                    if some[1] == 1 and some[2] == 1 then
                        for i=2,nofvalues-1 do
                            some = values[i]
                            if some[1] == 0 and some[2] == 0 then
                                return values
                            end
                        end
                    end
                end
            end
            return false
        end

        local version  = readulong(f) -- 0x00010000
        local reserved = readushort(f)
        local nofaxis  = readushort(f)
        local segments = { }
        for i=1,nofaxis do
            segments[i] = collect()
        end
        setvariabledata(fontdata,"segments",segments)
        -- Here begins the avar version 2 data section. Files can be smaller but of course
        -- the size of the instance stays the same. We might have faster caching.
        if version >> 16 == 2 then
            local axisindexmapoffset = readulong(f)
            local varstoreoffset     = readulong(f)
            if axisindexmapoffset > 0 then
                axisindexmapoffset = tableoffset + axisindexmapoffset
            end
            if varstoreoffset > 0 then
                varstoreoffset = tableoffset + varstoreoffset
            end
            local outerindex, innerindex, mapcount = readvariationindexmap(f,axisindexmapoffset)
            local regions, deltas
            if varstoreoffset > tableoffset then
                regions, deltas = readvariationdata(f,varstoreoffset)
            end
            if deltas then
                local map = { }
                for i=0,mapcount-1 do
                    map[i+1] = { outerindex[i], innerindex[i] }
                end
                setvariabledata(fontdata,"avar2",{ -- "variations"
                    map      = map,
                    mapcount = mapcount,
                    regions  = regions,
                    deltas   = deltas,
                })
            end
        end
    end
end

function readers.fvar(f,fontdata,specification)
    local tableoffset = gotodatatable(f,fontdata,"fvar",true) -- specification.variable or specification.instancenames
    if tableoffset then
        local version         = readulong(f) -- 0x00010000
        local offsettoaxis    = tableoffset + readushort(f)
        local reserved        = skipshort(f)
        -- pair 1
        local nofaxis         = readushort(f)
        local sizeofaxis      = readushort(f)
        -- pair 2
        local nofinstances    = readushort(f)
        local sizeofinstances = readushort(f)
        --
        local extras    = fontdata.extras
        local axis      = { }
        local instances = { }
        --
        setposition(f,offsettoaxis)
        --
        for i=1,nofaxis do
            local tag        = readtag(f)
            local minimum    = readfixed(f)
            local default    = readfixed(f)
            local maximum    = readfixed(f)
            local flags      = readushort(f)
            local axisnameid = readushort(f)
            axis[i] = {
                tag     = tag,   -- ital opsz slnt wdth wght
                minimum = minimum,
                default = default,
                maximum = maximum,
                flags   = flags,
                name    = axisnameid > 255 and axisnameid < 32768 and lower(extras[axisnameid] or "bad name") or "bad name",
            }
            local n = sizeofaxis - 20
            if n > 0 then
                skipbytes(f,n)
            elseif n < 0 then
                -- error
            end
        end
        --
        local nofbytes   = 2 + 2 + 2 + nofaxis * 4
        local readpsname = nofbytes <= sizeofinstances
        local skippable  = sizeofinstances - nofbytes
        for i=1,nofinstances do
            local subfamid = readushort(f)
            local flags    = readushort(f) -- 0, not used yet
            local values   = { }
            for i=1,nofaxis do
                values[i] = {
                    axis  = axis[i].tag,
                    value = readfixed(f),
                }
            end
            local psnameid = readpsname and readushort(f) or 0xFFFF
            if subfamid == 2 or subfamid == 17 then
                -- okay
            elseif subfamid == 0xFFFF then
                subfamid = nil
            elseif subfamid <= 255 or subfamid >= 32768 then
                subfamid = nil -- actually an error
            end
            if psnameid == 6 then
                -- okay
            elseif psnameid == 0xFFFF then
                psnameid = nil
            elseif psnameid <= 255 or psnameid >= 32768 then
                psnameid = nil -- actually an error
            end
            instances[i] = {
             -- flags     = flags,
                subfamily = extras[subfamid],
                psname    = psnameid and extras[psnameid] or nil,
                values    = values,
            }
            if skippable > 0 then
                skipbytes(f,skippable)
            end
        end
        setvariabledata(fontdata,"axis",axis)
        setvariabledata(fontdata,"instances",instances)
    end
end

local function calculate(f,fontdata,specification,offset,field,regions,deltas,nozero,variabletag)
    --
    -- innerIndexBitCountMask = 0x000F
    -- mapEntrySizeMask       = 0x0030
    -- reservedFlags          = 0xFFC0
    --
    -- outerIndex = entry >>       ((entryFormat & innerIndexBitCountMask) + 1)
    -- innerIndex = entry & ((1 << ((entryFormat & innerIndexBitCountMask) + 1)) - 1)
    --
    local outerindex, innerindex, mapcount = readvariationindexmap(f,offset)
    if variabletag then
        setvariabledata(fontdata,variabletag,true)
    end
    local glyphs = fontdata.glyphs
    for i=0,fontdata.nofglyphs-1 do
        local glyph = glyphs[i]
        local outer, inner
        if mapcount == 0 then
            outer, inner = 0, i
        elseif i < mapcount then
            outer, inner = outerindex[i], innerindex[i]
        else
            outer, inner = outerindex[mapcount-1], innerindex[mapcount-1]
        end
        if outer and inner then -- not needed
            local delta = deltas[outer+1]
            if delta then
                local d = delta.deltas[inner+1]
                if d then
                    local scales = delta.scales
                    local deltaw = field and glyph[field] or 0
                    for i=1,#scales do
                        local di = d[i]
                        if di then
                            deltaw = deltaw + scales[i] * di
                        else
                            break -- can't happen
                        end
                    end
                    deltaw = round(deltaw)
                    if nozero and deltaw == 0 then
                        -- no need for dlsb zero
                    else
                        glyph[field] = deltaw
                    end
                end
            end
        end
    end
end

-- Todo: when it's tested for a while the lsb hackery can be backported from the
-- font-dsp.lmt file.

function readers.hvar(f,fontdata,specification)
    local factors = specification.factors
    if not factors then
        return
    end
    local tableoffset = gotodatatable(f,fontdata,"hvar",specification.variable)
    if not tableoffset then
     -- report("no hvar table, expect problems due to messy widths")
        return
    end
    local version         = readulong(f) -- 0x00010000
    local variationoffset = tableoffset + readulong(f) -- the store
    local advanceoffset   = tableoffset + readulong(f)
    local lsboffset       = tableoffset + readulong(f)
    local rsboffset       = tableoffset + readulong(f)
    if variationoffset > tableoffset then
        local regions, deltas = readvariationdata(f,variationoffset,factors)
        if regions then
            calculate(f,fontdata,specification,advanceoffset > tableoffset and advanceoffset or nil,"width",regions,deltas,false,"hvarwidths")
            -- I don't want to save the lsb as it is the llx that we already store but as
            -- we're ahead of reading the bounding box so we cannot set the right lsb here
            -- so we set the delta (d) instead.
            if lsboffset > tableoffset then
                calculate(f,fontdata,specification,lsboffset,"dlsb",regions,deltas,true) -- delta lsb
            end
            if rsboffset > tableoffset then
                calculate(f,fontdata,specification,rsboffset,"drsb",regions,deltas,true)
            end
            setvariabledata(fontdata,"hvar",{
                regions = regions,
                deltas  = deltas,
            })
         -- setvariabledata(fontdata,"hregions",regions)
        end

    end

end

function readers.vvar(f,fontdata,specification)
    local factors = specification.factors
    if not factors then
        return
    end
    local tableoffset = gotodatatable(f,fontdata,"vvar",specification.variable)
    if not tableoffset then
        return
    end
    local version       = readulong(f)
    local variationoffset = tableoffset + readulong(f)
    local advanceoffset = tableoffset + readulong(f)
    local tsboffset     = tableoffset + readulong(f)
    local bsboffset     = tableoffset + readulong(f)
    local originoffset  = tableoffset + readulong(f)
    if variationoffset > tableoffset then
        local regions, deltas = readvariationdata(f,variationoffset,factors)
        if regions then
            calculate(f,fontdata,specification,advanceoffset > tableoffset and advanceoffset or nil,"dvadvance",regions,deltas,false,"vvar")
            if tsboffset > tableoffset then
                calculate(f,fontdata,specification,tsboffset,"dvtsb",regions,deltas,false,"vvar")
            end
            if bsboffset > tableoffset then
                calculate(f,fontdata,specification,bsboffset,"dvbsb",regions,deltas,false,"vvar")
            end
            if originoffset > tableoffset then
                calculate(f,fontdata,specification,originoffset,"dvorg",regions,deltas,false,"vvar")
            end
            setvariabledata(fontdata,"vvar",{
                regions = regions,
                deltas  = deltas,
            })
        end
    end
end

function readers.mvar(f,fontdata,specification)
    local tableoffset = gotodatatable(f,fontdata,"mvar",specification.variable)
    if tableoffset then
        -- The core reader does not otherwise need the optional gasp table,
        -- but MVAR records may target gasp range limits (gsp0..gsp9).
        if fontdata.tables.gasp and not fontdata.gasp then
            readers.gasp(f,fontdata,specification)
            setposition(f,tableoffset)
        end
        local version       = readulong(f) -- 0x00010000
        local reserved      = skipshort(f,1)
        local recordsize    = readushort(f)
        local nofrecords    = readushort(f)
        local storeoffset   = readushort(f)
        local offsettostore = storeoffset ~= 0 and tableoffset + storeoffset or 0
        local factors       = specification.factors
        local records       = { }
        local mvarmetrics   = { }
        if factors and offsettostore > 0 then
            local regions, deltas = readvariationdata(f,offsettostore,factors)
            for i=1,nofrecords do
                local tag   = readtag(f)
                local outer = readushort(f)
                local inner = readushort(f)
                records[i] = { tag = tag, outer = outer, inner = inner }
                local var = variabletags[tag]
             -- if var then
                    local delta = deltas[outer+1]
                    local dd    = 0
                    if delta then
                        local d  = delta.deltas[inner+1]
                        if d then
                            local scales = delta.scales
                            for i=1,#scales do
                                dd = dd + scales[i] * d[i]
                            end
                            dd = round(dd)
                            if var then
                                var(fontdata,dd)
                            end
                        end
                    end
                    mvarmetrics[tag] = dd
             -- end
                if recordsize > 8 then -- 4 + 2 + 2
                    skipbytes(f,recordsize-8)
                end
                fontdata.mvarmetrics = mvarmetrics
            end
        else
            for i=1,nofrecords do
                local tag = readtag(f)
                local outer = readushort(f)
                local inner = readushort(f)
                records[i] = { tag = tag, outer = outer, inner = inner }
                if recordsize > 8 then
                    skipbytes(f,recordsize-8)
                end
            end
        end
        setvariabledata(fontdata,"mvar",records)
    end
end

function readers.dsig(f,fontdata,specification)
    -- We're not going to deal with this security crap.
end
