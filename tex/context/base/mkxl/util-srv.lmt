table.setmetatableindex(server.messages, function()
    return "Internal Server Error"
end)

function server.reportstatistics(statistics)
    if type(statistics) == "table" then
     -- report()
        report("uptime           : %i seconds", statistics.uptime)
        report("requests         : %i",         statistics.requests)
        report("errors           : %i",         statistics.errors)
        report("active clients   : %i",         statistics.activeclients)
        report("max nofclients   : %i",         statistics.maxnofclients)
        report("bytes read       : %i",         statistics.bytesread)
        report("bytes sent       : %i",         statistics.byteswritten)
        report("client timeout   : %i seconds", statistics.clienttimeout)
        report("timedout clients : %i",         statistics.timedoutclients)
     -- report()
    else
        -- (server) statistics is an optional table in a request
    end
end
