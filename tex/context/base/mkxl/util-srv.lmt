    -- generic binary & executables

    bin      = "application/octet-stream",
    exe      = "application/octet-stream",

}

table.setmetatableindex(server.mimetypes, function(t,k)
    local suffix = match(match(k,"^([^?#]+)") or k,"%.?([%w_]+)$")
    return suffix and rawget(t,lower(suffix)) or "application/octet-stream"
end)

