if not modules then modules = { } end modules ['font-imp-collapse'] = {
    version   = 1.001,
    comment   = "companion to font-ini.mkiv",
    author    = "Hans Hagen, PRAGMA ADE",
    copyright = "ConTeXt Development Team",
    license   = "see context related readme files"
}

if not context then return end

local utfcharactertable = string.utfcharactertable

fonts.handlers.otf.addfeature {
    name       = "collapse",
 -- name       = "nfc",
    type       = "ligature",
    data       = { },
    nocheck    = true,
    prepend    = 1,
    initialize = function(specification)
        local data = specification.data
        for k, v in next, characters.collapsed do
            data[v] = utfcharactertable(k)
        end
        return false -- once
    end,
}
